{
  "name": "nova-tanks",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA TANKS canonical web game workspace",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "test": "node --test tests/node/*.test.js",
    "validate:dist": "node scripts/validate-dist.mjs",
    "production:verify": "npm run typecheck && npm run test && npm run build && npm run validate:dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.2",
    "@types/node": "20.14.11",
    "@types/react": "18.2.15",
    "@types/react-dom": "18.2.7",
    "@vitejs/plugin-react": "4.4.1",
    "tailwindcss": "4.3.2",
    "typescript": "5.5.4",
    "vite": "5.4.2"
  }
}
